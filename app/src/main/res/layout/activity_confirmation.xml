<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/confirmationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ConfirmationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/confirmationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirmation_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmationCabinLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/confirmation_cabin_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmationCabinValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_value" />

        <TextView
            android:id="@+id/confirmationDatesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/confirmation_dates_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmationDatesValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_value" />

        <TextView
            android:id="@+id/confirmationTotalLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/confirmation_total_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmationTotalValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_value" />
    </LinearLayout>
</ScrollView>
